<!doctype html>
<html lang="en">

<head><%- include('partials/head', { title }) %></head>

<body>
    <div class="app">
        <aside class="sidebar">
            <a class="brand" href="/"><span class="logo">E</span><span>EduFlow</span></a>
            <a class="side-link active" href="/dashboard">📊 Dashboard</a>
            <% if (user.role==='admin' || user.role==='teacher' ) { %>
                <a class="side-link" href="#students-section">🎓 Students</a>
                <% } %>
        </aside>

        <main class="main">
            <div class="topbar">
                <h1>Dashboard</h1>
                <div class="user-chip">
                    <span class="avatar">
                        <%= user.name[0].toUpperCase() %>
                    </span>
                    <div>
                        <div style="font-weight:600">
                            <%= user.name %>
                        </div>
                        <div style="font-size:11px;color:var(--muted);text-transform:capitalize">
                            <%= user.role %>
                        </div>
                    </div>
                    <button class="btn btn-ghost btn-sm" id="logout-btn">Logout</button>
                </div>
            </div>

            <% if (stats) { %>
                <section class="stats">
                    <div class="stat">
                        <div class="label">Total students</div>
                        <div class="value" id="stat-total">
                            <%= stats.total %>
                        </div>
                    </div>
                    <div class="stat">
                        <div class="label">Active</div>
                        <div class="value" id="stat-active">
                            <%= stats.active %>
                        </div>
                    </div>
                    <div class="stat">
                        <div class="label">Courses</div>
                        <div class="value" id="stat-courses">
                            <%= stats.courses %>
                        </div>
                    </div>
                </section>
                <% } %>
                    <% if (user.role==='admin' || user.role==='teacher' ) { %>
                        <section id="students-section">
                            <div class="toolbar">
                                <input id="search" placeholder="Search by name or email...">
                                <% if (user.role==='admin' ) { %>
                                    <button class="btn btn-primary" id="add-student-btn">+ Add student</button>
                                    <% } %>
                            </div>
                            <div class="table-wrap">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Grade</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="students-body">
                                        <% if (!students.length) { %>
                                            <tr>
                                                <td colspan="5" class="empty">No students found.</td>
                                            </tr>
                                            <% } %>
                                                <% students.forEach((s)=> { %>
                                                    <tr>
                                                        <td>
                                                            <%= s.first_name %>
                                                                <%= s.last_name %>
                                                        </td>
                                                        <td>
                                                            <%= s.email %>
                                                        </td>
                                                        <td>
                                                            <%= s.grade_level ?? '—' %>
                                                        </td>
                                                        <td><span class="badge badge-<%= s.status %>">
                                                                <%= s.status %>
                                                            </span></td>
                                                        <td style="text-align:right">
                                                            <button class="btn btn-ghost btn-sm" data-action="edit"
                                                                data-id="<%= s.id %>">Edit</button>
                                                            <% if (user.role==='admin' ) { %>
                                                                <button class="btn btn-danger btn-sm"
                                                                    data-action="delete"
                                                                    data-id="<%= s.id %>">Delete</button>
                                                                <% } %>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        <% } %>
                            <% if (user.role==='student' ) { %>
                                <section>
                                    <div class="table-wrap" style="padding:32px">
                                        <h2 style="margin-bottom:16px">My Profile</h2>
                                        <% if (!ownProfile) { %>
                                            <p style="color:var(--muted)">No student record linked to your account.</p>
                                            <% } else { %>
                                                <div
                                                    style="display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
                                                    <div>
                                                        <div style="font-size:12px;color:var(--muted)">NAME</div>
                                                        <div>
                                                            <%= ownProfile.first_name %>
                                                                <%= ownProfile.last_name %>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div style="font-size:12px;color:var(--muted)">EMAIL</div>
                                                        <div>
                                                            <%= ownProfile.email %>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div style="font-size:12px;color:var(--muted)">GRADE</div>
                                                        <div>
                                                            <%= ownProfile.grade_level ?? '—' %>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div style="font-size:12px;color:var(--muted)">STATUS</div>
                                                        <div><span class="badge badge-<%= ownProfile.status %>">
                                                                <%= ownProfile.status %>
                                                            </span></div>
                                                    </div>
                                                </div>
                                                <% } %>
                                    </div>
                                </section>
                                <% } %>
        </main>
    </div>

    <!-- Modal -->
    <div class="modal-backdrop" id="student-modal">
        <div class="modal">
            <h2 id="modal-title">Add student</h2>
            <form id="student-form">
                <div class="row">
                    <div class="field"><label>First name</label><input name="first_name" required></div>
                    <div class="field"><label>Last name</label><input name="last_name" required></div>
                </div>
                <div class="field"><label>Email</label><input name="email" type="email" required></div>
                <div class="row">
                    <div class="field"><label>Phone</label><input name="phone"></div>
                    <div class="field"><label>Grade level</label><input name="grade_level" placeholder="e.g. 10"></div>
                </div>
                <div class="row">
                    <div class="field"><label>Date of birth</label><input name="date_of_birth" type="date"></div>
                    <div class="field">
                        <label>Status</label>
                        <select name="status">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                            <option value="graduated">Graduated</option>
                        </select>
                    </div>
                </div>
                <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px">
                    <button type="button" class="btn btn-ghost" id="modal-cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Flash / toast container -->
    <div class="toast-container" id="toast-container" aria-live="polite"></div>

    <script>
        window.__USER__ = <% - JSON.stringify(user) %>;
    </script>
    <script type="module" src="/js/dashboard.js"></script>
</body>

</html>